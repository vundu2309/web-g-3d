{
  "name": "web-g-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:smoke": "node tests/physics-smoke.mjs",
    "test:ocean": "node tests/ocean-smoke.mjs",
    "wiki": "openwiki",
    "wiki:serve": "openwiki visualize openwiki --no-open",
    "wiki:export": "openwiki visualize openwiki --export .openwiki-export"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/havok": "^1.3.0"
  },
  "devDependencies": {
    "openwiki": "0.7.3",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
