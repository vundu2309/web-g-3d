{
  "name": "web-g-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "wiki": "openwiki",
    "wiki:serve": "openwiki visualize openwiki --no-open",
    "wiki:export": "openwiki visualize openwiki --export .openwiki-export",
    "lint": "eslint src",
    "format": "prettier --write src tests scripts eslint.config.js vite.config.ts",
    "format:check": "prettier --check src tests scripts eslint.config.js vite.config.ts",
    "test:unit": "node --test tests/rooms.test.mjs tests/diagnostics.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test": "npm run test:unit && npm run build && npm run test:browser",
    "check": "npm run lint && npm run format:check && npm test && npm run test:rules",
    "test:rules": "node scripts/test-rules.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "10.14.0",
    "firebase-tools": "^15.34.2",
    "openwiki": "0.7.3",
    "playwright-core": "^1.64.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "firebase": "13.2.0"
  }
}
