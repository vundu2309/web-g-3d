# Frontend (Vercel public variables). Without the first two the sea says the account service is not configured.
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY
VITE_API_URL=https://web-g-3d-api.onrender.com
VITE_AUTH_REDIRECT_URL=https://web-g-3d.vercel.app/
# The fish market and coins (needs the economy migration, applied to production on 2026-11-13).
# VITE_ECONOMY=on

# Render only (the Socket.IO API). It reads no database: it asks Supabase Auth who a token belongs to.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY
ALLOWED_ORIGINS=https://web-g-3d.vercel.app
