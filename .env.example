# Frontend staging only. Omit these to keep the existing Firebase runtime.
VITE_ONLINE_BACKEND=supabase
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY
VITE_API_URL=https://web-g-3d-api.onrender.com
VITE_AUTH_REDIRECT_URL=https://web-g-3d.vercel.app/
# The fish market and coins (needs the Supabase backend and the economy migration, applied to
# production on 2026-11-13).
# VITE_ECONOMY=on

# Render only. DATABASE_URL is secret: set through Render, never VITE_*.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY
ALLOWED_ORIGINS=https://web-g-3d.vercel.app
# Use a TLS-verified direct or session-mode pooler connection, never transaction mode.
# Backend enforces verified TLS even when the copied URL includes SSL flags.
DATABASE_URL=
